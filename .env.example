# --- HLStatsX Database Settings ---
DB_ROOT_PASS=hlstats_root_pass
DB_NAME=hlstatsx
DB_USER=hlstatsx
DB_PASS=hlstatsx_password
DB_PORT=3306

# --- HLStatsX General Settings ---
# Secret key for communication (must match your game server config)
PROXY_KEY=d7fe18f9c4d10180f2aa6393
# External port for the web interface
WEB_PORT=80

# --- Network Routing ---
# If the Forwarder and Daemon are on the same machine (Docker), use: hlx-daemon
# If the Forwarder is on a REMOTE machine, use the IP of your stats server:
DAEMON_HOST=hlx-daemon

# --- External Communication Ports ---
# UDP port for the Perl Daemon (Internal: 27500)
DAEMON_PORT=27500
# UDP port for the Forwarder (Where game servers send their logs)
FORWARDER_PORT=26999

# --- Game Server Identification ---
# The IP and Port of the game server being monitored (used for log identification)
GAME_SERVER_IP=192.168.1.1
GAME_SERVER_PORT=27015